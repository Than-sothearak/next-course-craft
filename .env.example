MONGODB_URI=mongodb://127.0.0.1:27017/coursecraft
AUTH_SECRET=generate-a-long-random-secret
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
# Required for media uploads: use a private S3 bucket and a scoped IAM role or key pair.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional AI course generation. Keep provider credentials server-side only.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
